<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SYMANAGE | Programme d'installation</title>

    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

</head>

<body class="gray-bg">

    <div class="middle-box text-center loginscreen animated fadeInDown">
        <div>
            <div>

                <h1 class="logo-name">SM+</h1>

            </div>
            <h3>Bienvenu sur SYMANAGE</h3>
            <p>Veuillez créer un compte administrateur.</p>
            {{ form_start(form) }}
                <div class="form-group">
                    {{ form_row(form.username) }}
                </div>
                <div class="form-group">
                    {{ form_row(form.fullName) }}
                </div>
                <div class="form-group">
                    {{ form_row(form.email) }}
                </div>
                <div class="form-group">
                    {{ form_row(form.plainPassword.first) }}
                </div>
                <div class="form-group">
                    {{ form_row(form.plainPassword.second) }}
                </div>
                <button class="btn btn-primary" type="submit">Créer l'administrateur</button>
            {{ form_end(form) }}
            <p class="m-t"> <small>Symanage &copy; {{ "now"|date("Y") }}</small> </p>
        </div>
    </div>

    {% block importmap %}{{ importmap('app') }}{% endblock %}
</body>

</html>